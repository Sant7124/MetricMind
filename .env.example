# Backend Settings
PROJECT_NAME="MetricMind API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
# Run 'openssl rand -hex 32' to generate a secure secret key for production
SECRET_KEY="placeholder_super_secret_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# Database (SQLite default for free tier)
SQLALCHEMY_DATABASE_URI="sqlite+aiosqlite:///./metricmind.db"

# LLM Provider Keys (Do NOT commit real keys here)
GEMINI_API_KEY="your_gemini_api_key_here"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Frontend Configuration (Used by Vite)
# Set this to your Render backend URL + /api/v1 when deploying on Vercel
VITE_API_URL="http://localhost:8001/api/v1"
