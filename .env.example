# ==========================================
# REQUIRED VARIABLES
# ==========================================

# Database
# Must be a PostgreSQL connection string in production (e.g. postgresql+asyncpg://...)
DATABASE_URL="postgresql+asyncpg://user:password@localhost/dbname"

# Security
# Run 'openssl rand -hex 32' to generate a secure secret key for production
SECRET_KEY="placeholder_super_secret_key_change_in_production"

# ==========================================
# PRODUCTION-ONLY VARIABLES
# ==========================================

# Environment (Set to 'production' to enforce strict checks like DATABASE_URL)
ENVIRONMENT="production"

# CORS Configuration (Required for frontend to communicate with backend)
# Format: JSON array of strings
BACKEND_CORS_ORIGINS='["https://your-frontend-domain.vercel.app"]'

# ==========================================
# OPTIONAL / DEVELOPMENT VARIABLES
# ==========================================

PROJECT_NAME="MetricMind API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# JWT Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Keys (At least one recommended for AI features)
GEMINI_API_KEY="your_gemini_api_key_here"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# ==========================================
# FRONTEND VARIABLES (Vite / Vercel)
# ==========================================

# Set this to your Render backend URL + /api/v1 when deploying on Vercel
# E.g. https://metricmind-api.onrender.com/api/v1
VITE_API_URL="http://localhost:8000/api/v1"
